---
// Self-hosted fonts (Fontsource) — no third-party Google Fonts request.
import '@fontsource/sora/400.css';
import '@fontsource/sora/500.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import headerHtml from '../content/_header.html?raw';
import footerHtml from '../content/_footer.html?raw';
import scriptsRaw from '../content/_scripts.js?raw';
import consentHtml from '../content/_consent.html?raw';
import NAVMAP from '../content/_navmap.json';

export interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const site = Astro.site ?? new URL('https://haidrun.io');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og-default.png', site).href;

// Staging guard: default to NON-indexable. Flip PUBLIC_INDEXABLE=true at production launch.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Haidrun',
  legalName: 'Haidrun AB',
  url: 'https://haidrun.io',
  sameAs: [
    'https://www.linkedin.com/company/haidrun',
    'https://github.com/haidrun',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Stockholm',
    addressCountry: 'SE',
  },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Haidrun" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</head>
<body>
  <Fragment set:html={headerHtml} />

  <main>
    <slot />
  </main>

  <Fragment set:html={footerHtml} />

  <div class="beta">Site v0.99A · staging</div>

  <!-- Cookie consent (CMP) -->
  <Fragment set:html={consentHtml} />
  <script is:inline>
    (function () {
      var NAME = 'haidrun_consent';
      var VERSION = 1;          // bump to re-ask everyone
      var MAX_AGE = 60 * 60 * 24 * 180; // 180 days

      function readConsent() {
        var m = document.cookie.match(/(?:^|;\s*)haidrun_consent=([^;]+)/);
        if (!m) return null;
        try {
          var c = JSON.parse(decodeURIComponent(m[1]));
          if (!c || c.v !== VERSION) return null;
          return c;
        } catch (e) { return null; }
      }
      function writeConsent(analytics, marketing) {
        var c = { v: VERSION, necessary: true, analytics: !!analytics, marketing: !!marketing, t: new Date().toISOString() };
        var secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = NAME + '=' + encodeURIComponent(JSON.stringify(c)) +
          '; Max-Age=' + MAX_AGE + '; Path=/; SameSite=Lax' + secure;
        apply(c);
        return c;
      }
      // Activate scripts gated behind a category. Author gated tags with
      // type="text/plain" and data-consent="analytics"; they run only after consent.
      function activate(cat) {
        document.querySelectorAll('script[type="text/plain"][data-consent="' + cat + '"]').forEach(function (s) {
          if (s.dataset.ccActivated) return;
          var n = document.createElement('script');
          for (var i = 0; i < s.attributes.length; i++) {
            var a = s.attributes[i];
            if (a.name === 'type' || a.name === 'data-consent') continue;
            n.setAttribute(a.name, a.value);
          }
          n.text = s.textContent;
          s.dataset.ccActivated = '1';
          s.parentNode.insertBefore(n, s.nextSibling);
        });
      }
      function apply(c) {
        if (c.analytics) activate('analytics');
        if (c.marketing) activate('marketing');
        document.dispatchEvent(new CustomEvent('haidrun:consent', { detail: c }));
      }

      var banner = document.getElementById('cc-banner');
      var modal = document.getElementById('cc-modal');
      var inA = document.getElementById('cc-analytics');
      var inM = document.getElementById('cc-marketing');

      function showBanner(v) {
        if (!banner) return;
        banner.classList.toggle('show', v);
        banner.setAttribute('aria-hidden', v ? 'false' : 'true');
      }
      function openModal() {
        var c = readConsent();
        if (inA) inA.checked = c ? !!c.analytics : false;
        if (inM) inM.checked = c ? !!c.marketing : false;
        modal.classList.add('show');
        modal.setAttribute('aria-hidden', 'false');
      }
      function closeModal() {
        modal.classList.remove('show');
        modal.setAttribute('aria-hidden', 'true');
      }

      function on(id, fn) { var el = document.getElementById(id); if (el) el.addEventListener('click', fn); }
      on('cc-accept-all', function () { writeConsent(true, true); showBanner(false); closeModal(); });
      on('cc-reject-all', function () { writeConsent(false, false); showBanner(false); });
      on('cc-customize', openModal);
      on('cc-save', function () { writeConsent(inA && inA.checked, inM && inM.checked); showBanner(false); closeModal(); });
      on('cc-modal-reject', function () { writeConsent(false, false); showBanner(false); closeModal(); });
      on('cc-modal-close', closeModal);
      if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('show')) closeModal(); });

      // Persistent re-open control (e.g. footer "Cookie settings")
      document.querySelectorAll('[data-cc-open]').forEach(function (el) {
        el.classList.add('cc-open');
        el.addEventListener('click', function (e) { e.preventDefault(); openModal(); });
      });

      // Public API
      window.HaidrunConsent = { get: readConsent, open: openModal, set: writeConsent };

      // Init: honour existing consent, otherwise prompt
      var existing = readConsent();
      if (existing) { apply(existing); showBanner(false); }
      else { showBanner(true); }
    })();
  </script>

  <!-- Multipage nav: turn data-nav elements into real links -->
  <script is:inline define:vars={{ NAVMAP, current: path }}>
    document.querySelectorAll('[data-nav]').forEach((el) => {
      const url = NAVMAP[el.dataset.nav];
      if (!url) return;
      el.style.cursor = 'pointer';
      el.addEventListener('click', () => { window.location.href = url; });
      if (url === current) el.classList.add('active');
    });
  </script>

  <!-- Preserved animation scripts (node network + count-up), guarded -->
  <script is:inline set:html={scriptsRaw} />
</body>
</html>
